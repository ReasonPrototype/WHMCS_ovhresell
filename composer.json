{
    "name": "ovhvps/whmcs-module",
    "description": "WHMCS server module to resell OVHcloud VPS and VPS-n8n",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ovh/ovh": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "OvhVps\\": "lib/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
